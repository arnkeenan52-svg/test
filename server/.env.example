# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored — never commit your real key.

# Your Anthropic API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Port the local bridge listens on.
# Must be > 1024 and not 1194 (Roblox HttpService blocks those from Studio).
PORT=8765
